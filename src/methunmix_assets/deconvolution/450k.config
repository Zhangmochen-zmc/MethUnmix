params {
    // ==========================================
    // 1. 全局配置
    // ==========================================
    outdir        = "${projectDir}/results_array_450k"
    tools         = "all"  
    runtime_mode  = "conda"
    random_seed   = 20260826
    methylcibersort_permutations = 1000
    medecom_k     = 6
    medecom_lambda = "auto"
    medecom_nfolds = 0
    medecom_output_contract = "reference_free_components_v2"
    aric_min_overlap = 500
    epidish_reference_mode = "bundle_artifact"
    epidish_builtin_reference = ""
    epidish_postprocess_profile = "dynamic"
    
    // 默认基础环境 (作为保底)
    local_conda_env = "${projectDir}/conda/array_env"

    // ==========================================
    // 2. 工具独立 Conda 环境路径 (精确指向文件夹或压缩包)
    // ==========================================
    env_aric            = "${projectDir}/conda/aric_env"
    env_edec            = "${projectDir}/conda/edec_env"
    env_emeth           = "${projectDir}/conda/emeth_env"
    env_episcore        = "${projectDir}/conda/episcore_env"
    env_epidish         = "${projectDir}/conda/epidish_env"
    env_tsisal          = "${projectDir}/conda/tsisal_env"
    env_houseman        = "${projectDir}/conda/houseman_env"
    env_methatlas       = "${projectDir}/conda/methatlas_env"
    env_reffree         = "${projectDir}/conda/reffreeewas_env"
    env_prmeth          = "${projectDir}/conda/prmeth_env"
    env_methylcibersort = "${projectDir}/conda/methylcibersort_env"
    env_medecom         = "${projectDir}/conda/medecom_env"  
    env_menet           = "${projectDir}/conda/menet_env" 


    // ==========================================
    // 3. 输入数据与参考文件
    // ==========================================
    input_dir           = "${projectDir}/450k_data/*.csv"
    ref_dir             = "${projectDir}/450k_ref"
    
    ref_aric            = "${params.ref_dir}/ARIC.csv"
    ref_cibersort       = "${params.ref_dir}/MethylCIBERSORT.txt"
    ref_edec_data       = "${params.ref_dir}/EDEC.txt"
    ref_edec_meta       = "${params.ref_dir}/EDEC_meta.csv"
    ref_edec_mark       = "${params.ref_dir}/EDEC_markers.rds"
    ref_edec_tref       = null
    ref_emeth           = "${params.ref_dir}/EMeth.RData"
    ref_epidish         = "${params.ref_dir}/EpiDISH.csv"
    ref_episcore        = "${params.ref_dir}/EpiSCORE.csv"
    ref_episcore_gene   = null
    ref_houseman_cell   = "${params.ref_dir}/Houseman_cell.rds"
    ref_houseman_beta   = "${params.ref_dir}/Houseman_beta.rds"
    ref_menet           = "${params.ref_dir}/MEnet.pickle"
    menet_cell_types    = "${projectDir}/reference_cell_types.json"
    menet_min_overlap_regions = 100
    menet_min_overlap_fraction = 0.05
    ref_methatlas       = "${params.ref_dir}/MethAtlas.csv"
    ref_reffree         = "${params.ref_dir}/RefFreeEWAS.csv"
    ref_prmeth          = "${params.ref_dir}/PRMeth.csv" 
    ref_tsisal          = "${params.ref_dir}/Tsisal.csv"

    // 脚本路径
    script_atlas        = "${params.ref_dir}/MethAtlas.py" 
}

// ==========================================
// 环境与执行配置
// ==========================================
conda.enabled = true
conda.useMamba = true 

process {
    // 默认使用基础环境
    conda = params.local_conda_env
    
    // 基础资源配置
    cpus   = 1
    memory = '8 GB'
    time   = '2h'
    
    // 错误处理策略
    errorStrategy = { task.exitStatus in [143,137,104,134,139] ? 'retry' : 'finish' }
    maxRetries    = 1

    // =========================================================
    // 【核心修改】针对特定工具分配专属环境与资源
    // =========================================================

    withName: 'RUN_ARIC' {
        conda = params.env_aric
    }

    withName: 'PREP_EDec|RUN_EDec' {
        conda = params.env_edec
    }

    withName: 'RUN_EMeth' {
        conda = params.env_emeth
        memory = '20 GB'
        time = '5h'
    }

    withName: 'PREP_EpiSCORE|RUN_EpiSCORE' {
        conda = params.env_episcore
    }

    withName: 'RUN_Tsisal' {
        conda = params.env_tsisal
        memory = '12 GB'
    }

    withName: 'RUN_EpiDISH' {
        conda = params.env_epidish
        memory = '12 GB'
    }

    withName: 'RUN_Houseman' {
        conda = params.env_houseman
        memory = '12 GB'
    }

    withName: 'RUN_MEnet' {
        // 修正：指向 params 中定义的 tar.gz
        conda = params.env_menet
        memory = '16 GB'
        cpus   = 2
    }

    withName: 'RUN_MethAtlas' {
        conda = params.env_methatlas
    }

    withName: 'RUN_RefFreeEWAS' {
        conda = params.env_reffree
        memory = '12 GB'
    }

    withName: 'RUN_PRmeth' {
        conda = params.env_prmeth
        memory = '12 GB'
    }

    withName: 'RUN_MethylCIBERSORT' {
        conda = params.env_methylcibersort
        memory = '32 GB'
        cpus = 4
    }

    // MeDeCom 任务：分配专属环境与重型资源
    withName: 'RUN_MeDeCom' {
        conda  = params.env_medecom
        cpus   = 12
        memory = '40 GB'
        time   = '10h'
    }

    withName: 'POST_PROCESS_MEDECOM_V1' {
        conda  = params.env_medecom
        memory = '2 GB'
    }

}

// ==========================================
// 报告生成配置
// ==========================================
report {
    enabled = true
    file    = "${params.outdir}/pipeline_report.html"
    overwrite = true
}

timeline {
    enabled = true
    file    = "${params.outdir}/pipeline_timeline.html"
    overwrite = true
}

trace {
    enabled = true
    file    = "${params.outdir}/resource_consumption.txt"
    fields  = 'task_id,name,status,exit,realtime,%cpu,rss,peak_rss,vmem,peak_vmem'
    overwrite = true
}
