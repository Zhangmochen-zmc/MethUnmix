params {
    // ==========================================
    // 1. 全局配置
    // ==========================================
    outdir        = "${projectDir}/results_wgbs"
    // 运行模式: "all" 或指定具体工具如 "menet,uxm"
    tools         = "all"
    runtime_mode  = "conda"
    random_seed   = 20260826
    genome_build  = "hg38"
    // MEnet resolves this to a logical CPU or CUDA device.  The CLI runner
    // always sets it from --accelerator so it participates in the task hash.
    menet_device  = "cpu"
    // MethylBERT compact tissue models use an explicit CPU/GPU device.
    methylbert_device = "cpu"
    gpu_count     = 1

    local_conda_env = "${projectDir}/conda/wgbs_env"

    // ==========================================
    // 2. 输入数据路径
    // ==========================================
    input_bed_dir = "${projectDir}/wgbs_data/bed"
    input_pat_dir = "${projectDir}/wgbs_data/pat"

    // CelFEER E3A owner-approved resource contract.  This is a scheduler
    // envelope only; it does not change algorithm, reference, truth, or
    // scientific-status semantics.
    celfeer_group_concurrency = 1
    celfeer_overall_timeout_seconds = 5400

    // ==========================================
    // 3. Third-party implementations are external runtime modules.
    // The CLI always supplies these paths after validating the explicit
    // methunmix-external-runtime.json contract; there is intentionally no
    // source-tree/vendor fallback in the distributable workflow.
    external_runtime_root = null
    tool_metdecode  = null
    tool_celfie     = null
    tool_celfeer    = null
    tool_uxm        = null

    // ==========================================
    // 4. 自定义脚本目录
    // ==========================================
    scripts_dir     = "${projectDir}/wgbs_scripts"

    // ==========================================
    // 5. 参考文件与模型 (References)
    // ==========================================
    // MEnet
    ref_menet_model     = "${projectDir}/wgbs_ref/menet/MEnet_model.pickle"
    menet_cell_types    = "${projectDir}/reference_cell_types.json"
    menet_min_overlap_regions = 100
    menet_min_overlap_fraction = 0.05
    
    // MetDecode
    ref_metdecode_atlas = "${projectDir}/wgbs_ref/metdecode/ref_atlas.tsv"
    
    // CelFiE
    ref_celfie_atlas    = "${projectDir}/wgbs_ref/celfie/tims.txt"
    celfie_k            = 1
    
    // CelFEER
    ref_celfeer_cpg     = "${projectDir}/wgbs_ref/celfeer/hg38_cpg_ref.txt"
    ref_celfeer_bins    = "${projectDir}/wgbs_ref/celfeer/read_bins.txt"
    ref_celfeer_markers = "${projectDir}/wgbs_ref/celfeer/markers.txt"
    ref_celfeer_cell_types = "${projectDir}/wgbs_ref/celfeer/cell_types.tsv"
    
    // UXM
    ref_uxm_atlas       = "${projectDir}/wgbs_ref/uxm/marker_atlas.csv"
    
    // MethylBERT
    mb_model_dir        = "${projectDir}/wgbs_ref/methylbert/finetune_b256"
    mb_reference_root   = "${projectDir}/wgbs_ref/methylbert"
    mb_ref_markers      = "${projectDir}/wgbs_ref/methylbert/markers_with_id.tsv"
    mb_train_data = "${projectDir}/wgbs_ref/methylbert/input/training_data/train_seq.kmers_fixed.csv"
    mb_runtime_metadata = null
    mb_batch_size       = 128
    mb_cpu_batch_size   = 32
    // Upstream read simulation uses process-local Python RNG state.  A single
    // deterministic worker is required for fixed-seed release reproducibility.
    mb_prepare_cores    = 1
}

// ==========================================
// 环境与执行配置
// ==========================================
conda.enabled = true
conda.useMamba = true // 推荐开启，下载环境更快

process {
    // 默认使用根目录下的 environment.yml
    conda = "${projectDir}/conda/wgbs_env"
    
    withName: 'PRE_METHYLBERT_PREPARE|PRE_METHYLBERT_FIX|RUN_METHYLBERT' {
        conda = "${projectDir}/conda/methylbert_env"
        // 如果 MethylBERT 需要 GPU，也可以在这里增加资源限制
        // memory = '64 GB'
    }

    // 错误处理: 遇到错误立即停止
    shell = ['/bin/bash', '-euo', 'pipefail']
    
    // 资源配置 (根据你的服务器配置调整)
    withLabel: 'big_mem' {
        cpus = 8
        memory = '32 GB'
    }

    withName: RUN_UXM {
        cpus   = 12
        memory = '32 GB'
        // 如果是在集群运行，可以指定 container 或 conda
    }

    withName: 'RUN_MENET' {
        cpus = 2
        memory = '16 GB'
        maxForks = 1
    }

    // E3A CelFEER production contract (approved after retry2 authoritative
    // telemetry).  CPU requests are scheduler envelopes; all numerical
    // libraries remain clamped to one thread below.
    withName: PRE_CELFEER_STEP1 {
        cpus   = 2
        memory = '16 GB'
        time   = '900 sec'
        maxForks = 1
        errorStrategy = 'finish'
        beforeScript = 'export OMP_NUM_THREADS=1 OMP_THREAD_LIMIT=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1 NUMEXPR_NUM_THREADS=1 BLIS_NUM_THREADS=1 VECLIB_MAXIMUM_THREADS=1'
    }

    withName: PRE_CELFEER_MERGE {
        cpus   = 2
        memory = '4 GB'
        time   = '60 sec'
        maxForks = 1
        errorStrategy = 'finish'
        beforeScript = 'export OMP_NUM_THREADS=1 OMP_THREAD_LIMIT=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1 NUMEXPR_NUM_THREADS=1 BLIS_NUM_THREADS=1 VECLIB_MAXIMUM_THREADS=1'
    }

    withName: RUN_CELFEER {
        cpus   = 1
        memory = '1 GB'
        time   = '60 sec'
        maxForks = 1
        errorStrategy = 'finish'
        beforeScript = 'export OMP_NUM_THREADS=1 OMP_THREAD_LIMIT=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1 NUMEXPR_NUM_THREADS=1 BLIS_NUM_THREADS=1 VECLIB_MAXIMUM_THREADS=1'
    }

    withName: POST_PROCESS_CELFEER {
        cpus   = 1
        memory = '1 GB'
        time   = '30 sec'
        maxForks = 1
        errorStrategy = 'finish'
        beforeScript = 'export OMP_NUM_THREADS=1 OMP_THREAD_LIMIT=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1 NUMEXPR_NUM_THREADS=1 BLIS_NUM_THREADS=1 VECLIB_MAXIMUM_THREADS=1'
    }

    // MERGE_TOOL_RESULTS is the common native-WGBS result writer.  Its
    // approved CelFEER envelope is intentionally conservative and is also
    // safe for other native-WGBS tools using the same merge process.
    withName: MERGE_TOOL_RESULTS {
        cpus   = 1
        memory = '1 GB'
        time   = '30 sec'
        maxForks = 1
        errorStrategy = 'finish'
        beforeScript = 'export OMP_NUM_THREADS=1 OMP_THREAD_LIMIT=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1 NUMEXPR_NUM_THREADS=1 BLIS_NUM_THREADS=1 VECLIB_MAXIMUM_THREADS=1'
    }
}

// 启用报告
report {
    enabled = true
    file    = "${params.outdir}/pipeline_report.html"
    overwrite = true
}

timeline {
    enabled = true
    file    = "${params.outdir}/pipeline_timeline.html"
    overwrite = true
}

trace {
    enabled = true
    file    = "${params.outdir}/resource_consumption.txt"
    fields  = 'task_id,name,status,exit,realtime,%cpu,rss,peak_rss,vmem,peak_vmem'
    overwrite = true
}
