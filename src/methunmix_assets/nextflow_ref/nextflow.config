manifest {
    name = 'deconvolution-marker-nextflow'
    version = '1.0.0'
    description = 'Marker selection orchestration for 450K, EPIC and WGBS deconvolution tools'
    mainScript = 'main.nf'
    nextflowVersion = '>=24.04.0'
}

params {
    data_type = null
    tools = 'all'
    reference_root = null
    metadata = null
    input_mode = 'auto'
    menet_input_root = null
    menet_metadata = null
    celfeer_input_root = null
    celfeer_metadata = null
    celfeer_pat_root = null
    celfeer_cpg_ref = null
    uxm_pat_root = null
    methylbert_reads_root = null
    methylbert_pretrain = null
    scenario_id = null
    menet_bismark_script = "${projectDir}/bin/bismark.py"
    wgbs_to_850k_script = "${projectDir}/bin/wgbs_to_850.py"
    genome_build = null
    sample_id_column = 'GSM'
    cell_type_column = 'cell_type'
    wgbs_validation_lines = 1000
    celfeer_validation_lines = 1000
    menet_workers = 12
    menet_check_sorted = true
    celfeer_workers = 12
    celfeer_bin_workers = 4
    heavy_tool_mode = 'split'
    seed = 123
    outdir = 'results'
    assets_dir = "${projectDir}/assets"
    tool_source_dir = "${projectDir}/tools"
}

process {
    executor = 'local'
    errorStrategy = 'terminate'
    shell = ['/bin/bash', '-euo', 'pipefail']

    withName: VALIDATE_INPUT {
        publishDir = [path: "${params.outdir}/run_manifest", mode: 'copy', overwrite: true]
    }
    withName: VALIDATE_MENET_INPUT {
        publishDir = [path: "${params.outdir}/menet/preconverted_manifest", mode: 'copy', overwrite: true]
    }
    withName: DISCOVER_MENET_METADATA {
        publishDir = [path: "${params.outdir}/menet/preconverted_manifest", mode: 'copy', overwrite: true]
    }
    withName: VALIDATE_CELFEER_INPUT {
        publishDir = [path: "${params.outdir}/celfeer/preconverted_manifest", mode: 'copy', overwrite: true]
    }
    withName: DISCOVER_CELFEER_METADATA {
        publishDir = [path: "${params.outdir}/celfeer/preconverted_manifest", mode: 'copy', overwrite: true]
    }
    withName: DISCOVER_METADATA {
        publishDir = [path: "${params.outdir}/run_manifest", mode: 'copy', overwrite: true]
    }
    withName: CELFEER_PREPROCESS {
        publishDir = [path: "${params.outdir}/celfeer/pre", mode: 'copy', overwrite: true]
    }
    withName: MENET_BISMARK_PREPROCESS {
        publishDir = [path: "${params.outdir}/menet/pre", mode: 'copy', overwrite: true]
    }
    withName: WGBS_TO_850K {
        publishDir = [path: "${params.outdir}/common/wgbs_to_850k", mode: 'copy', overwrite: true]
    }
    withName: PREPARE_ARRAY_REFERENCE {
        publishDir = [path: "${params.outdir}/common", mode: 'copy', overwrite: true]
    }
    withName: GENERATE_MENET_METADATA {
        publishDir = [path: "${params.outdir}/menet", mode: 'copy', overwrite: true]
    }
    withName: RUN_MARKER_TOOL {
        publishDir = [path: { "${params.outdir}/${tool}" }, mode: 'copy', overwrite: true]
    }
    withName: CELFEER_BUILD_MARKERS {
        publishDir = [path: "${params.outdir}/celfeer", mode: 'copy', overwrite: true]
    }
    withName: CELFIE_BUILD_TIMS {
        publishDir = [path: "${params.outdir}/celfie", mode: 'copy', overwrite: true]
    }
    withName: METDECODE_FINALIZE {
        publishDir = [path: "${params.outdir}/metdecode", mode: 'copy', overwrite: true]
    }
    withName: BUILD_UXM_REFERENCE {
        publishDir = [path: "${params.outdir}/uxm", mode: 'copy', overwrite: true]
    }
    withName: BUILD_METHYLBERT_REFERENCE {
        publishDir = [path: "${params.outdir}/methylbert", mode: 'copy', overwrite: true]
    }
}

env {
    PYTHONHASHSEED = '123'
    DECONVOLUTION_SEED = '123'
}

profiles {
    standard { }
    singularity {
        conda.enabled = false
        singularity.enabled = true
        singularity.autoMounts = true
        process.container = "${projectDir}/containers/deconvolution.sif"
    }
    apptainer {
        conda.enabled = false
        apptainer.enabled = true
        apptainer.autoMounts = true
        process.container = "${projectDir}/containers/deconvolution.sif"
    }
    conda {
        conda.enabled = true
        conda.useMamba = true
        conda.cacheDir = "${projectDir}/.conda"
    }
}

timeline { enabled = true; overwrite = true; file = "${params.outdir}/pipeline_info/timeline.html" }
report   { enabled = true; overwrite = true; file = "${params.outdir}/pipeline_info/report.html" }
trace    { enabled = true; overwrite = true; file = "${params.outdir}/pipeline_info/trace.txt" }
dag      { enabled = true; overwrite = true; file = "${params.outdir}/pipeline_info/dag.html" }
